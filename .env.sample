# Frontend access and pipeline configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://marsapp.vercel.app
BI_PIPELINE_MODE=multi

# Supabase database and storage configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=datasets

# External AI service API credentials
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
HF_TOKEN=your-hugging-face-read-token

# LangSmith tracing and evaluation configuration
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=mars
EVAL_JUDGE_MODEL=your-independent-groq-model
EVAL_REPETITIONS=3
EVAL_MAX_CONCURRENCY=1
